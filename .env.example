DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_RESEARCH_CHANNEL_ID=
DISCORD_ADMIN_IDS=
# Optional development guild: commands appear immediately there.
DISCORD_GUILD_ID=
# Semantic paraphrasing is required for automatic publication.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
# Optional Telegram destination (Discord administration remains available in persistent mode).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_RESEARCH_CHAT_ID=
MODE=high_signal
MIN_SCORE=75
POLL_SECONDS=300
MAX_POST_AGE_HOURS=72
MAX_LLM_PER_CYCLE=20
DATABASE_PATH=data/news.sqlite3
SOURCES_PATH=sources.json
# First run saves existing posts without publishing them.
BACKFILL=false
LOG_LEVEL=INFO
# Enable only if your local VPN/TUN intentionally resolves sites into 198.18.0.0/15.
ALLOW_FAKE_IP_DNS=false
